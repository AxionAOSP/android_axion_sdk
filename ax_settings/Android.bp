package {
    default_visibility: ["//visibility:public"],
}

filegroup {
    name: "ax_settings",
    srcs: [
        "src/**/*.kt",
        "src/**/*.java",
    ],
    visibility: ["//visibility:public"],
}

android_library {
    name: "ax_settings_res",
    manifest: "AndroidManifest.xml",
    resource_dirs: ["res"],
    visibility: ["//visibility:public"],
}
