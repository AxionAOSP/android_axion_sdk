package {
    default_visibility: ["//visibility:public"],
}

filegroup {
    name: "ax_dragonite_core_sources",
    srcs: [
        "core/**/*.java",
    ],
    visibility: ["//frameworks/base/services/core"],
}

filegroup {
    name: "services.dragonite-sources",
    srcs: [
        "src/**/*.kt",
    ],
    path: "src",
    visibility: ["//visibility:private"],
}

java_library {
    name: "services.dragonite-pre-jarjar",
    defaults: ["platform_service_defaults"],
    srcs: [":services.dragonite-sources"],
    libs: [
        "services.core",
        "kotlin-annotations",
    ],
    static_libs: [
        "kotlin-stdlib",
        "kotlin-stdlib-jdk7",
    ],
    kotlincflags: [
        "-Xjvm-default=all",
        "-Xno-call-assertions",
        "-Xno-param-assertions",
        "-Xno-receiver-assertions",
    ],
}

java_library {
    name: "services.dragonite",
    static_libs: ["services.dragonite-pre-jarjar"],
    jarjar_rules: "jarjar-rules.txt",
    visibility: ["//frameworks/base/services"],
}
