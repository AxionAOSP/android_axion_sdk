package {
    default_visibility: ["//visibility:public"],
}

android_library {
    name: "ax_icon_loader",
    manifest: "AndroidManifest.xml",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],

    resource_dirs: ["res"],

    static_libs: [
        "androidx.core_core",
        "kotlin-stdlib",
    ],

    platform_apis: true,
    min_sdk_version: "31",

    kotlincflags: [
        "-Xjvm-default=all",
    ],

    use_resource_processor: true,
}
